  grid:
    '<rect x="3.5" y="3.5" width="7.5" height="7.5" rx="1.5"/><rect x="13" y="3.5" width="7.5" height="7.5" rx="1.5"/><rect x="3.5" y="13" width="7.5" height="7.5" rx="1.5"/><rect x="13" y="13" width="7.5" height="7.5" rx="1.5"/>',
  chef:
    '<path d="M7 21h10M9 21v-6.3M15 21v-6.3"/><path d="M6 10.5A3 3 0 0 1 8.4 6a3.5 3.5 0 0 1 6.9-1 3 3 0 0 1 3.7 3.4A3 3 0 0 1 18 14.7H7A3 3 0 0 1 6 10.5Z"/>',
  palette:
    '<path d="M12 3.5a8.5 8.5 0 1 0 0 17c1 0 1.6-.8 1.2-1.7-.3-.7.2-1.5 1-1.5H16a4 4 0 0 0 4-4c0-5.4-3.6-9.8-8-9.8Z"/><circle cx="8" cy="12" r="1"/><circle cx="9.5" cy="8" r="1"/><circle cx="14" cy="7.5" r="1"/><circle cx="16.5" cy="11" r="1"/>',
  offline:
    '<path d="M4 9.5a12 12 0 0 1 6.3-3.3M13.8 6.2A12 12 0 0 1 20 9.5M7 13a7.5 7.5 0 0 1 3.6-1.9M13.4 11.1A7.5 7.5 0 0 1 17 13M10.2 16.4a3.3 3.3 0 0 1 3.6 0"/><path d="M12 19.5h.01"/><path d="M3 3l18 18"/>',
