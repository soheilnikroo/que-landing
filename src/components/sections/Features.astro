---

<section id="features" class="post-journey section-shell py-24" aria-labelledby="features-title">
  <div class="features-intro">
    <p class="features-intro__eyebrow">امکانات</p>
    <h2 id="features-title" class="features-intro__title">همه‌چیز برای رستوران شلوغ</h2>
    <p class="features-intro__body">
      از پیدا کردن رستوران تا مدیریت میز — یک جریان ساده برای مهمان و برای پرسنل، با همه امکاناتی که هر طرف لازم دارد.
    </p>
  </div>

  <div class="features-group">
    <div class="features-group__head">
      <span class="features-group__badge features-group__badge--guest">برای مهمان</span>
    </div>
    <div class="features-grid">
      {
        guestFeatures.map((feature) => (
          <article class="feature-card">
            <span class="feature-card__icon" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${icons[feature.icon]}</svg>`} />
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))
      }
    </div>
  </div>

  <div class="features-group">
    <div class="features-group__head">
      <span class="features-group__badge features-group__badge--staff">برای پرسنل</span>
    </div>
    <div class="features-grid">
      {
        staffFeatures.map((feature) => (
          <article class="feature-card feature-card--staff">
            <span class="feature-card__icon feature-card__icon--staff" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${icons[feature.icon]}</svg>`} />
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))
      }
    </div>
  </div>

  <div class="features-platform">
    {
      platformNotes.map((note) => (
        <div class="features-platform__item">
          <strong>{note.title}</strong>
          <span>{note.body}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .features-intro {
    max-width: 36rem;
    margin-bottom: 2.5rem;
  }

  .features-intro__eyebrow {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .features-intro__title {
    margin: 0.75rem 0 0;
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 800;
    color: var(--color-primary);
  }

  .features-intro__body {
    margin: 0.85rem 0 0;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .features-group {
    margin-top: 2.75rem;
  }

  .features-group:first-of-type {
    margin-top: 0;
  }

  .features-group__head {
    margin-bottom: 1.1rem;
  }

  .features-group__badge {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-accent) 14%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--color-accent) 28%, transparent);
  }

  .features-group__badge--staff {
    color: #2e3440;
    background: color-mix(in srgb, #b08d57 16%, var(--color-surface));
    border-color: color-mix(in srgb, #b08d57 32%, transparent);
  }

  html[data-theme='dark'] .features-group__badge--staff {
    color: #e3c893;
  }

  .features-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 720px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-card {
    padding: 1.5rem;
    border-radius: 1.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: 0 10px 28px rgb(var(--color-shadow-ambient) / 5%);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px rgb(var(--color-shadow-ambient) / 8%);
  }

  .feature-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.9rem;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
  }

  .feature-card__icon--staff {
    color: #b08d57;
    background: color-mix(in srgb, #b08d57 16%, transparent);
  }

  .feature-card__icon :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }

  .feature-card h3 {
    margin: 1rem 0 0;
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-primary);
  }

  .feature-card p {
    margin: 0.6rem 0 0;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .features-platform {
    display: grid;
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--color-secondary) 55%, var(--color-surface));
    border: 1px solid var(--color-border);
  }

  @media (min-width: 720px) {
    .features-platform {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .features-platform__item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .features-platform__item strong {
    font-size: 0.95rem;
    color: var(--color-primary);
  }

  .features-platform__item span {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
</style>
