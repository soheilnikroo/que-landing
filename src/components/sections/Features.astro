    body: 'جستجو کنید، روی نقشه ببینید، یا QR رستوران را اسکن کنید — همراه با وضعیت شلوغی همان لحظه.',
    icon: 'search',
  },
  {
    title: 'صف زنده',
    body: 'موقعیت دقیق در صف، تخمین زمان انتظار، و اعلان لحظه‌ای وقتی نوبتتان نزدیک می‌شود.',
    icon: 'pulse',
  },
  {
    title: 'رزرو میز',
    body: 'از قبل میز رزرو کنید و مستقیم سر وقت بروید — بدون ایستادن در صف.',
    icon: 'calendar',
  },
  {
    title: 'سفارش از منو',
    body: 'منوی رستوران را ببینید، سفارش بدهید و سبد خرید را مستقیم از گوشی مدیریت کنید.',
    icon: 'menu',
  },
  {
    title: 'نشست حضوری با QR میز',
    body: 'با اسکن QR روی میز، نشست شما ثبت می‌شود و مسیر گارسون تا میزتان روشن است.',
    icon: 'qr',
  },
  {
    title: 'تاریخچه بازدید',
    body: 'بازدیدها و سفارش‌های قبلی خود را در یک‌جا ببینید و دوباره سفارش بدهید.',
    icon: 'history',
  },
]

const staffFeatures: Feature[] = [
  {
    title: 'مدیریت صف',
    body: 'همه مهمان‌های منتظر، اندازه گروه و زمان انتظار در یک لیست زنده — فراخوانی با یک ضربه.',
    icon: 'list',
  },
  {
    title: 'مدیریت میزها',
    body: 'نقشه سالن را ببینید: خالی، پر یا در حال تمیز شدن، با پیشنهاد میز مناسب برای هر گروه.',
    icon: 'grid',
  },
  {
    title: 'رزروهای رستوران',
    body: 'رزروهای پیش‌رو را ببینید و مدیریت کنید تا میزها همیشه سر وقت آماده باشند.',
    icon: 'calendar',
  },
  {
    title: 'مدیریت منو',
    body: 'آیتم‌های منو، قیمت و موجودی را به‌روز نگه دارید — همان لحظه برای مهمان‌ها نمایش داده می‌شود.',
    icon: 'chef',
  },
  {
    title: 'برندینگ رستوران',
    body: 'نام، لوگو و رنگ رستوران خودتان را تنظیم کنید تا اپ مهمان با هویت شما باز شود.',
    icon: 'palette',
  },
  {
    title: 'کار بدون اینترنت',
    body: 'در قطعی اینترنت هم صف و میزها کار می‌کنند؛ به محض وصل شدن، همه‌چیز همگام می‌شود.',
    icon: 'offline',
  },
]

const platformNotes = [
  { title: 'وب و PWA', body: 'مستقیم در مرورگر، یا افزوده‌شده به صفحه اصلی گوشی.' },
  { title: 'اندروید (TWA)', body: 'نصب کامل روی اندروید، برای مهمان و پرسنل جدا.' },
  { title: 'دو زبانه', body: 'فارسی و انگلیسی، با پشتیبانی کامل راست‌به‌چپ.' },
]

const icons: Record<string, string> = {
  search:
    '<circle cx="11" cy="11" r="6.5"/><path d="m20 20-3.7-3.7"/>',
  pulse:
    '<path d="M3 12h4l2-6 4 12 2-6h6"/>',
  calendar:
    '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/>',
  menu:
    '<path d="M5 4h11l3 4-3 4H5z"/><path d="M5 12v8M5 16h6"/>',
  qr:
    '<rect x="3.5" y="3.5" width="6.5" height="6.5" rx="1"/><rect x="14" y="3.5" width="6.5" height="6.5" rx="1"/><rect x="3.5" y="14" width="6.5" height="6.5" rx="1"/><path d="M14 14h3v3h-3zM20.5 14v3M14 20.5h3M20.5 20.5h.01"/>',
  history:
    '<path d="M3.5 12a8.5 8.5 0 1 0 2.7-6.2"/><path d="M3.5 4v4.5H8"/><path d="M12 8v4.3l3 2"/>',
