---
import { faqs } from '@/content/faqs'
---

<section id="faq" class="post-journey section-shell py-24" aria-labelledby="faq-title">
  <div class="mb-10 max-w-2xl">
    <p class="text-sm font-semibold text-[var(--color-accent)]">سوالات متداول</p>
    <h2 id="faq-title" class="mt-3 text-3xl font-bold text-[var(--color-primary)]">
      قبل از شروع
    </h2>
  </div>
  <div class="grid gap-4">
    {
      faqs.map((item, index) => (
        <details class="faq-item rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
          <summary class="faq-item__summary cursor-pointer text-lg font-semibold text-[var(--color-primary)]">
            {item.q}
          </summary>
          <p id={`faq-answer-${index}`} class="mt-3 leading-7 text-[var(--color-muted)]">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item__summary {
    list-style: none;
  }

  .faq-item__summary::-webkit-details-marker {
    display: none;
  }

  .faq-item__summary::marker {
    content: '';
  }
</style>
