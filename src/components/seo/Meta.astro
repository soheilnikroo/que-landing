---
import { OG_IMAGE_SRC, SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '@/content/brand'
import { faqs } from '@/content/faqs'
import { buildStructuredDataGraph } from '@/lib/seo/structured-data'

const canonicalUrl = Astro.site?.href ?? `${SITE_URL}/`
const ogImageUrl = new URL(OG_IMAGE_SRC, canonicalUrl).href
const structuredData = JSON.stringify(buildStructuredDataGraph(faqs))
---

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="light dark" />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="author" content="صف" />
<meta name="format-detection" content="telephone=no" />
<title>{SITE_TITLE}</title>
<meta name="description" content={SITE_DESCRIPTION} />
<link rel="canonical" href={canonicalUrl} />
<link rel="preload" as="image" href="/assets/scene-01.svg" fetchpriority="high" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="صف" />
<meta property="og:locale" content="fa_IR" />
<meta property="og:title" content={SITE_TITLE} />
<meta property="og:description" content={SITE_DESCRIPTION} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:type" content="image/svg+xml" />
<meta property="og:image:alt" content={SITE_TITLE} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={SITE_TITLE} />
<meta name="twitter:description" content={SITE_DESCRIPTION} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={SITE_TITLE} />
<script is:inline type="application/ld+json" set:html={structuredData}></script>
